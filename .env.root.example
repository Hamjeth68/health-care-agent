# Root-level environment configuration reference
# This file shows all environment variables needed across the project
# Copy values to backend/.env and frontend/.env respectively

# ========================================
# BACKEND ENVIRONMENT (backend/.env)
# ========================================

# Supabase backend integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS configuration (comma-separated list of allowed origins)
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ========================================
# FRONTEND ENVIRONMENT (frontend/.env)
# ========================================

# Backend API URL
VITE_API_URL=http://127.0.0.1:8000

# Supabase frontend integration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# WHERE TO GET THESE VALUES
# ========================================
#
# 1. Create a Supabase project at https://app.supabase.com
# 2. Go to Settings → API to find:
#    - SUPABASE_URL: "Project URL"
#    - SUPABASE_SERVICE_ROLE_KEY: "service_role secret" (keep this SECRET)
#    - VITE_SUPABASE_ANON_KEY: "anon public" (safe for frontend)
#
# 3. VITE_API_URL: Local backend URL (default: http://127.0.0.1:8000)
#
# 4. CORS_ALLOW_ORIGINS: Frontend URLs that backend should accept requests from
#

# ========================================
# SECURITY NOTES
# ========================================
#
# DO NOT:
#   - Commit .env files to Git (already in .gitignore)
#   - Share SUPABASE_SERVICE_ROLE_KEY with anyone
#   - Use SERVICE_ROLE_KEY in frontend code
#
# DO:
#   - Keep SERVICE_ROLE_KEY in backend/.env only
#   - Use ANON_KEY in frontend/.env only
#   - Rotate keys periodically from Supabase dashboard
#

# ========================================
# SETUP INSTRUCTIONS
# ========================================
#
# 1. Copy this file:
#    - backend/.env.example exists (use it directly)
#    - frontend/.env.example exists (use it directly)
#
# 2. Edit backend/.env:
#    - Replace SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
#    - Update CORS_ALLOW_ORIGINS if needed
#
# 3. Edit frontend/.env:
#    - Replace VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
#    - Update VITE_API_URL if backend runs on different port
#
# 4. Do NOT commit .env files
#
# For detailed setup guide, see SUPABASE_SETUP.md
#
